{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.preview)",
      "Read(**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/secrets/**)",
      "Read(**/.secret/**)",
      "Read(**/.secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.preview)",
      "Edit(**/.envrc)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.crt)",
      "Edit(**/*.cer)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/secrets/**)",
      "Edit(**/.secret/**)",
      "Edit(**/.secrets/**)",
      "Edit(**/credentials/**)",
      "Edit(**/credentials.json)",
      "Edit(**/service-account*.json)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  }
}
