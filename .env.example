# Copy to .env.local at the repository root. Never commit filled credentials.
# Optional site origin: no path, query, credentials or fragment.
# Defaults: http://localhost:3000 in development; https://motchi.ca in production.
# Production overrides require HTTPS and cannot use loopback addresses.
SOLUTIONS_URL=

# Brevo-verified sender and monitored business inbox.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Server-only transactional email API key.
BREVO_API_KEY=

# Set to true in the Production environment only, when the site launches.
# Anything else (or a non-production origin) keeps search engines out.
ALLOW_INDEXING=

# Required in production: stable random secret, at least 32 characters.
# Development may generate a temporary process-wide fallback.
CONTACT_FORM_SECRET=
