# Copy into EACH app's .env.local. Next loads env from the app directory, not the monorepo root.
# This template contains no secrets. Never commit a filled .env file.

# ==========================================
# Site Origins — Optional, Server-Resolved
# ==========================================
# Leave blank for defaults: localhost:3000/3001/3002 in development; published domains in production.
# Override all three for staging or alternate local ports. Use an origin only: no path/query/credentials.
# Production overrides must use HTTPS and cannot point to localhost/loopback.
# Published defaults: https://motchi.ca, https://websites.motchi.ca, https://consulting.motchi.ca.
SOLUTIONS_URL=
WEBSITES_URL=
CONSULTING_URL=

# ==========================================
# Contact / Email — Required to Send Enquiries
# ==========================================
# Brevo-verified sender; this is not the visitor's email.
CONTACT_FROM_EMAIL=
# Monitored inbox receiving business enquiries; distinct from the public email in source config.
CONTACT_TO_EMAIL=

# ==========================================
# Brevo — Server Secret, Required to Send
# ==========================================
# Never prefix credentials with NEXT_PUBLIC_.
BREVO_API_KEY=

# ==========================================
# Form Security — Server Secret
# ==========================================
# Required in production: at least 32 random characters; stable across instances of this app.
# Use a distinct secret per environment. Development can generate a temporary process-wide fallback.
CONTACT_FORM_SECRET=
