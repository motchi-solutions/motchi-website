# Copy this file to each app's .env.local. Next.js loads env files from the app directory.
# Never prefix these with NEXT_PUBLIC_. Never commit filled environment files.
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# At least 32 characters. Keep stable across production instances; use a unique secret per environment.
CONTACT_FORM_SECRET=
