# Environment variables. Placeholders only; never commit .env.local.
# All values are server-only. Empty means unset. Restart `npm run dev` after edits.
#
#   Variable               Local           Vercel Production    Vercel Preview
#   SOLUTIONS_URL          optional        unset                unset
#   CONTACT_FROM_EMAIL     send tests      required             unset
#   CONTACT_TO_EMAIL       send tests      required             unset
#   BREVO_API_KEY          send tests      required, Sensitive  unset
#   CONTACT_FORM_SECRET    optional        required, Sensitive  unset
#   TURNSTILE_SITE_KEY     -               required             unset
#   TURNSTILE_SECRET_KEY   -               required, Sensitive  unset
#   KV_REST_API_URL        -               added by Vercel      unset
#   KV_REST_API_TOKEN      -               added by Vercel      unset
#   ALLOW_INDEXING         -               "true"               unset
#
# Previews need nothing: the contact form shows "email us instead" and
# search engines stay out. Production serves https://www.motchi.ca (sites.ts);
# leave SOLUTIONS_URL unset there.


# ---- Local (.env.local) -----------------------------------------------------

# Site origin. Default http://localhost:3000; set only for another port.
SOLUTIONS_URL=

# Brevo, only for real send tests. Without them the form shows its email fallback.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
BREVO_API_KEY=

# Optional: development generates a temporary secret.
CONTACT_FORM_SECRET=

# Turnstile uses Cloudflare's test keys and rate limits use memory locally.


# ---- Vercel Production only (set in Vercel, not here) ----------------------

# Brevo: verified sender, enquiry inbox, and API key (Sensitive).
# CONTACT_FROM_EMAIL=<hello@motchi.ca>
# CONTACT_TO_EMAIL=<contact@motchi.ca>
# BREVO_API_KEY=<Brevo > SMTP & API > API keys>

# Form signing, 32+ characters: `openssl rand -hex 32` (Sensitive).
# CONTACT_FORM_SECRET=<random secret>

# Cloudflare Turnstile: Managed widget whose hostnames include www.motchi.ca,
# pre-clearance off.
# The site key is public; the secret key is Sensitive.
# TURNSTILE_SITE_KEY=<site key>
# TURNSTILE_SECRET_KEY=<secret key>

# Upstash Redis rate limits, added when connected under Vercel > Storage.
# Other KV_* and REDIS_URL values Vercel adds are unused. An Upstash account
# can use UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN instead.
# KV_REST_API_URL=<https://...upstash.io>
# KV_REST_API_TOKEN=<token>

# Lets search engines index the production site. Leave unset to keep them out.
# ALLOW_INDEXING=true
