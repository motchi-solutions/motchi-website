{
  "name": "motchi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@motchi/solutions",
    "dev:solutions": "npm run dev --workspace=@motchi/solutions",
    "dev:websites": "npm run dev --workspace=@motchi/websites",
    "dev:consulting": "npm run dev --workspace=@motchi/consulting",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome lint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
